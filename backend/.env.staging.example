DATABASE_URL="postgresql://followup:followup@your-postgres-host:5432/followup"
AUTH_SECRET="replace-me-with-a-long-random-secret"
GMAIL_CLIENT_ID="your-google-client-id"
GMAIL_CLIENT_SECRET="your-google-client-secret"
GMAIL_MOCK_MODE="false"
PORT="4000"
CORS_ORIGIN="https://your-frontend-domain.vercel.app"
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX_REQUESTS="120"
RATE_LIMIT_WINDOW_MS="60000"
STRIPE_PAYMENT_LINK_MODE="mock"
STRIPE_SOLO_PAYMENT_LINK=""
STRIPE_STUDIO_PAYMENT_LINK=""
TRIAL_DAYS="14"
SEED_PROD_DATA="false"
RUN_RELEASE_ON_BOOT="true"
FORCE_PRISMA_GENERATE_ON_RELEASE="false"
